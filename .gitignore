__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
evidence/*.jsonl
/tmp/

# The agent signing key is a live credential: never commit it.
.synth/
*.key

# ZK build outputs are regenerated by scripts/build_zk.sh. The proving key is
# the exception: the verifier bytecode is derived from it, so committing one
# without the other yields a verifier that rejects every proof.
build/*
!build/zk/
build/zk/*
!build/zk/settlement_0.zkey
!build/zk/settlement.r1cs
!build/zk/settlement_js/
build/zk/settlement_js/*
!build/zk/settlement_js/settlement.wasm
!build/zk/settlement_js/generate_witness.js
!build/zk/settlement_js/witness_calculator.js
node_modules/

# Fuel runtime state: per-run, regenerated by the engine on first settlement.
# The compiled ledger artifacts above are kept because deploying needs them
# even when `forc` is unavailable.
sway/chain/genesis/
sway/chain/contract_id.txt
sway/chain/settlements.json
sway/settlement_ledger/out/debug/debug_symbols.obj
